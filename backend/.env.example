# AI Subscription Platform Environment Variables
# Copy this file to .env and fill in your values

# Application Settings
PROJECT_NAME="AI Subscription Platform"
VERSION="1.0.0"
DEBUG=True
SECRET_KEY="your-secret-key-here-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Settings (SQLite by default)
DATABASE_URL="sqlite:///./sql_app.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/db_name"

# External API Credentials
# GGSel (https://ggsel.net)
GGSEL_USERNAME="your_ggsel_username"
GGSEL_PASSWORD="your_ggsel_password"

# FunPay (https://funpay.com)
FUNPAY_USERNAME="your_funpay_username"
FUNPAY_PASSWORD="your_funpay_password"

# Oyunfor (https://oyunfor.com)
OYUNFOR_USERNAME="your_oyunfor_username"
OYUNFOR_PASSWORD="your_oyunfor_password"

# Kie.ai (https://kie.ai)
KIE_AI_API_KEY="your_kie_ai_api_key"

# Bitpin API (https://bitpin.ir)
BITPIN_API_KEY="your_bitpin_api_key"

# Crypto Settings
CRYPTO_PAYMENT_ADDRESS="your_crypto_wallet_address"
CRYPTO_NETWORK="TRC20"  # TRC20, BTC, ETH

# Email Settings (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_email_password"
SMTP_FROM_EMAIL="noreply@yoursite.com"

# Redis Settings (for Celery)
REDIS_URL="redis://localhost:6379/0"

# Application Settings
DEFAULT_MARGIN=0.30  # 30% default margin
PAYMENT_FEE=0.01    # 1% payment fee
PROCUREMENT_TIMEOUT=300  # 5 minutes timeout for procurement

# Supplier List
SUPPLIERS=["ggsel", "funpay", "oyunfor", "kie_ai", "sharetool"]
